{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment.schema.json",
  "title": "板书数字化 · 单阶段调参实验（experiment）",
  "type": "object",
  "required": [
    "kind",
    "run_id",
    "samples",
    "variants"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "experiment"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "01",
        "02",
        "03",
        "04",
        "05",
        "06",
        "07",
        "08",
        "09"
      ]
    },
    "stage_name": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "winner": {
      "type": "string"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "images"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "images": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "captions": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "compare": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
